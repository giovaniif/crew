#!/usr/bin/env bash
set -euo pipefail

apk="${1:-$(dirname "$0")/src-tauri/gen/android/app/build/outputs/apk/universal/debug/app-universal-debug.apk}"
pkg=sh.giovani.crew

adb wait-for-device
adb install -r "$apk"

crashed() {
  adb logcat -d -b crash | grep -q "$pkg"
}

launch() {
  adb shell am force-stop "$pkg" || true
  adb shell input keyevent KEYCODE_WAKEUP || true
  adb shell input keyevent 82 || true
  adb shell am start -W -n "$pkg/.MainActivity"
  for _ in $(seq 1 30); do
    if adb shell dumpsys activity activities | grep -q "topResumedActivity.*$pkg"; then
      sleep 5
      adb shell pidof "$pkg" >/dev/null && ! crashed
      return
    fi
    sleep 2
  done
  return 1
}

adb logcat -c
for attempt in 1 2; do
  if launch; then
    echo "android smoke: $pkg runs"
    exit 0
  fi
  if crashed; then
    break
  fi
  echo "android smoke: attempt $attempt: $pkg is not the resumed activity" >&2
  adb shell dumpsys activity activities | grep -E 'topResumedActivity|mResumedActivity' >&2 || true
done

adb logcat -d -b crash || true
echo "android smoke: $pkg did not start" >&2
exit 1
