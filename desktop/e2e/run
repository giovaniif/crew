#!/usr/bin/env bash
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/../.." && pwd)
app=${CREW_E2E_APP:-$root/desktop/src-tauri/target/debug/crew-desktop}
port=${CREW_E2E_PORT:-5179}
tmp=$(mktemp -d /tmp/crew-e2e.XXXXXX)
pids=()
cleanup() {
  for pid in "${pids[@]}"; do kill "$pid" 2>/dev/null || true; done
  rm -rf "$tmp"
}
trap cleanup EXIT

export CREW_HOME="$tmp/home"
export CREW_TMUX_SOCKET="$tmp/tmux"
export HOME="$tmp/user"
export XDG_DATA_HOME="$tmp/user/data"
mkdir -p "$CREW_HOME" "$HOME" "$XDG_DATA_HOME"

(cd "$root/web" && CREW_FAKE_API=1 exec npx vite --host 127.0.0.1 --port "$port" --strictPort) >"$tmp/vite.log" 2>&1 &
pids+=($!)
for _ in $(seq 1 60); do
  curl -fsS "http://127.0.0.1:$port/" >/dev/null 2>&1 && break
  sleep 0.5
done
curl -fsS "http://127.0.0.1:$port/" >/dev/null || { cat "$tmp/vite.log"; exit 1; }

export CREW_URL="http://127.0.0.1:$port/"
tauri-driver >"$tmp/driver.log" 2>&1 &
pids+=($!)
for _ in $(seq 1 40); do
  curl -fsS http://127.0.0.1:4444/status >/dev/null 2>&1 && break
  sleep 0.25
done

status=0
CREW_E2E_APP="$app" node --test "$here"/*.test.mjs || status=$?
[ "$status" -eq 0 ] || cat "$tmp/driver.log"
exit "$status"
