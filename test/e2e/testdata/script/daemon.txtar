exec crew daemon start
stdout '^crew daemon started \(pid [0-9]+\)$'
exists $CREW_HOME/crew.pid

exec crew daemon status
stdout '^pid [0-9]+$'
stdout '^uptime '
stdout '^sessions 0$'
stdout '^worktrees 0$'

exec crew daemon
stderr '^crew daemon: a daemon of this build already runs \(pid [0-9]+\), so this one exits$'

exec crew daemon start
stdout '^crew daemon already running \(pid [0-9]+\)$'

exec crew daemon stop
stdout '^crew daemon stopped \(pid [0-9]+\)$'
! exec crew daemon status
stderr '^crew daemon: not running$'
! exists $CREW_HOME/crew.pid

! exec crew daemon stop
stderr 'not running'
