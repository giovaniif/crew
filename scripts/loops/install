#!/usr/bin/env bash
set -euo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
repo="$(git -C "$here" worktree list --porcelain | sed -n '1s/^worktree //p')"
units="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
bin="${XDG_DATA_HOME:-$HOME/.local/share}/crew-loops"
stamp="$(date +%Y%m%d-%H%M%S)"
names=(crew-loop-patrol crew-loop-maintenance crew-loop-digest)

backup() {
  if [ -e "$1" ]; then
    cp -p "$1" "$1.bak-$stamp"
    echo "backup: $1.bak-$stamp"
  fi
}

if [ "${1:-}" = "--remove" ]; then
  for n in "${names[@]}"; do
    systemctl --user disable --now "$n.timer" 2>/dev/null || true
    for f in "$units/$n.service" "$units/$n.timer"; do
      backup "$f"
      rm -f "$f"
    done
  done
  for f in run cleanup; do
    backup "$bin/$f"
    rm -f "$bin/$f"
  done
  systemctl --user daemon-reload
  echo "removed the crew loops"
  exit 0
fi
if [ $# -gt 0 ]; then
  echo "usage: scripts/loops/install [--remove]" >&2
  exit 2
fi

mkdir -p "$units" "$bin"
for f in run cleanup; do
  if ! cmp -s "$here/$f" "$bin/$f"; then
    backup "$bin/$f"
    install -m 755 "$here/$f" "$bin/$f"
    echo "installed: $bin/$f"
  fi
done

escape() {
  printf '%s' "$1" | sed 's/[\\&|]/\\&/g'
}
repo_e="$(escape "$repo")"
bin_e="$(escape "$bin")"
path_e="$(escape "$PATH")"

for src in "$here"/units/*; do
  dst="$units/$(basename "$src")"
  tmp="$(mktemp)"
  sed -e "s|@REPO@|$repo_e|g" -e "s|@BIN@|$bin_e|g" -e "s|@PATH@|$path_e|g" "$src" >"$tmp"
  if cmp -s "$tmp" "$dst"; then
    rm -f "$tmp"
    continue
  fi
  backup "$dst"
  mv "$tmp" "$dst"
  chmod 644 "$dst"
  echo "installed: $dst"
done

systemctl --user daemon-reload
for n in "${names[@]}"; do
  systemctl --user enable --now "$n.timer"
done
systemctl --user list-timers 'crew-loop-*' --no-pager
