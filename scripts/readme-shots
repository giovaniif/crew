#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
out="$root/docs/images/readme"
limit="${README_SHOT_LIMIT:-409600}"
mkdir -p "$out"
demo="$(mktemp -d /tmp/crew-demo.XXXXXX)"
trap 'rm -rf "$demo"' EXIT
mkdir -p "$demo/home/src/api" "$demo/home/src/web"
for repo in api web; do
  git -C "$demo/home/src/$repo" init -q -b main
  git -C "$demo/home/src/$repo" -c user.name=demo -c user.email=demo@example.com commit -q --allow-empty -m init
done

(cd "$out" && "$root/scripts/web-screenshot" <<STEPS
device Desktop Chrome
scheme light
mode installed
goto /
fill Pairing code=ABCD2345
click Pair
see add retries
goto /#/sessions/s3
see add retries
wait 800
shot desktop-chat.png
tab Review
wait 1200
shot desktop-review.png
goto /#/new
wait 800
shot desktop-new-session.png
goto /#/automations
see last run succeeded
wait 300
shot desktop-automations.png
goto /#/disk
wait 800
shot desktop-disk.png
goto /#/mates
see pip
wait 600
shot desktop-mates.png
goto /#/mates/pip
see Never force-push main
wait 600
shot desktop-mate.png
device iPhone 15
scheme light
mode installed
goto /
fill Pairing code=ABCD2345
click Pair
see Needs you
wait 400
shot phone-sessions.png
goto /#/sessions/s3
see add retries
wait 600
shot phone-chat.png
STEPS
)

if command -v oxipng >/dev/null 2>&1; then
  oxipng -q -o 4 --strip safe "$out"/*.png
fi
big=0
for f in "$out"/*.png; do
  size="$(wc -c <"$f")"
  if [ "$size" -gt "$limit" ]; then
    echo "readme-shots: $f is $size bytes, more than $limit" >&2
    big=1
  fi
done
exit "$big"
